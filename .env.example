DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
SUPERUSERS=["YOUR_QQ_NUMBER"]
COMMAND_START=["/"]
COMMAND_SEP=["."]
OWNER_QQ=YOUR_QQ_NUMBER
# Optional: point to a private sibling repo such as ../qq-bot-private
DATA_REPO_DIR=../qq-bot-private
# Optional: LLM for natural language interaction (OpenAI-compatible API)
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=sk-no-key
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
